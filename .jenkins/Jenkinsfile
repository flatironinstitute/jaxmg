pipeline {
    agent none
    stages {
        stage('CUDA 12') {
            agent {
                dockerfile {
                    filename '.jenkins/Dockerfile12'
                    args '--gpus=2 --shm-size=4gb'
                    label 'docker && v100'
                }
            }

            options {
                timeout(time: 60, unit: 'MINUTES')
            }
            stages {
                stage('Compile') {
                    environment {
                        PARALLEL = "${env.PARALLEL}"
                    }
                    steps {
                        sh '''#!/bin/bash -ex
                        export CUDA_ROOT=/usr/local/cuda
                        export CUDNN_ROOT=/usr
                        export PATH=/usr/local/cuda/bin:$PATH
                        export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
                        mkdir -p build && cd build
                        cmake -DCMAKE_BUILD_TYPE=Release ..
                        cmake --build . --target install -- -j${PARALLEL:-$(nproc)}
                        echo "Built libs at $WORKSPACE/src/jaxmg/bin:"
                        ls -la "$WORKSPACE/src/jaxmg/bin"
                    '''
                        stash name: 'compiled-bin', includes: 'src/jaxmg/bin/**', useDefaultExcludes: false
                    }
                }
                stage('Local') {
                    steps {
                        unstash 'compiled-bin'
                        sh '''#!/bin/bash -ex
                        echo "LDD baseline on built libraries"
                        for so in "$WORKSPACE/src/jaxmg/bin"/*.so; do
                            echo ">>> $so"
                            ldd "$so" || true
                        done
                        '''
                    }
                }
                stage('JAX NVIDIA') {
                    steps {
                        unstash 'compiled-bin'
                        sh '''#!/bin/bash -ex
                        echo "Unlinking selected CUDA libraries, then rerunning ldd"
                        libs=(
                            libcupti.so.12
                            libcublas.so.12
                            libcublasLt.so.12
                            libcusparse.so.12
                            libcusolver.so.11
                            libcusolverMg.so.11
                        )
                        for lib in "${libs[@]}"; do
                            path=$(ldconfig -p | awk -v L="$lib" '$1==L {print $NF}' | head -n1 || true)
                            if [ -n "$path" ]; then
                                echo "Unlinking $lib at $path"
                                unlink "$path" || rm -f "$path" || echo "Failed to unlink $path"
                            else
                                echo "Library $lib not found in ldconfig cache"
                            fi
                        done

                        echo "Rerunning ldd on built libraries"
                        for so in "$WORKSPACE/src/jaxmg/bin"/*.so; do
                            echo ">>> $so"
                            ldd "$so" || true
                        done
                        '''
                    }
                }
            }
        }
        stage('CUDA 13') {
            agent {
                dockerfile {
                    filename '.jenkins/Dockerfile13'
                    args '--gpus=2 --shm-size=4gb'
                    label 'docker && v100'
                }
            }

            options {
                timeout(time: 60, unit: 'MINUTES')
            }
            steps {
                sh '''#!/bin/bash -ex
                    echo "CUDA13"
                '''
            }
        }
    }
}
