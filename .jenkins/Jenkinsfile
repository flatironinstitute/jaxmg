pipeline {
    agent {
        dockerfile {
            filename '.jenkins/Dockerfile'
            args '--gpus=2 --shm-size=4gb'
            label 'docker && v100'
        }
    }
    options {
        timeout(time: 30, unit: 'MINUTES')
    }
    environment {
        HOME = "$WORKSPACE"
    }
    stages {
        stage('Compile') {
            environment {
                PARALLEL = "${env.PARALLEL}"
            }
            steps {
                sh '''#!/bin/bash -ex
                    export CUDA_ROOT=/usr/local/cuda
                    export CUDNN_ROOT=/usr
                    export PATH=/usr/local/cuda/bin:$PATH
                    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
                    mkdir -p third_party/gpus
                    ln -sfn third_party/gpus/cuda
                    mkdir -p build && cd build
                    cmake -DCMAKE_BUILD_TYPE=Release ..
                    cmake --build . --target install -- -j$PARALLEL
                '''
            }
        }
        stage('Build and Test')
        {
            matrix {
                axes {
                    axis {
                        name 'JAX_VERSION'
                        values '0.6.2', '0.7.2', '0.8.1'
                    }
                }
                environment {
                    CUDA_VISIBLE_DEVICES = '0,1'
                }
                stages {
                    stage('Build ') {
                        steps {
                            sh '''#!/bin/bash -ex
                                    python3 -m venv $HOME/$JAX_VERSION/.venv
                                    source $HOME/$JAX_VERSION/.venv/bin/activate
                                    python3 -m pip install --upgrade pip build
                                    # Build wheel into a per-version dist directory
                                    OUTDIR="$HOME/$JAX_VERSION/dist"
                                    mkdir -p "$OUTDIR"
                                    python3 -m build --wheel --outdir "$OUTDIR"
                                '''
                        }
                    }
                    stage('Test') {
                        steps {
                            sh '''#!/bin/bash -ex
                        source $HOME/$JAX_VERSION/.venv/bin/activate
                        # Install JAX and the wheel built for this version from its own dist dir
                        python3 -m pip install "$HOME/$JAX_VERSION/dist/jaxmg-"*.whl "jax[cuda12]==$JAX_VERSION"
                        python3 -m pip install pytest matplotlib
                        python3 -m pytest -svv
                        '''
                        }
                    }
                }
            }
        }
    }
}
