properties([
  disableConcurrentBuilds(),
  buildDiscarder(logRotator(numToKeepStr: '8', daysToKeepStr: '30')),
  pipelineTriggers([cron('@monthly')])
])

// Native backend build settings.
//
// The backend is built against XLA as the external Bazel repo `@xla`, from
// inside the official JAX CI container (tensorflow/ml-build:latest) using a JAX
// checkout. The Flatiron Jenkins pods cannot run nested containers (no docker
// socket, runAsUser 1000), so instead of `docker exec`-ing into the CI
// container we run the build *directly* in a pod whose image IS that container
// (runPod(image: ...)). JAX_GIT_TAG must be compatible with the `jax==0.10.1`
// pin in pyproject.toml (the JAX checkout determines the XLA revision behind
// `@xla`).
JAX_GIT_REPOSITORY = 'https://github.com/jax-ml/jax.git'
JAX_GIT_TAG        = 'jax-v0.10.1'
// Full Artifact Registry path for the JAX CI container (the public image the
// `tensorflow/ml-build:latest` shorthand resolves to via ci/envs/docker.env).
// docker.io/tensorflow/ml-build is not publicly pullable.
ML_BUILD_IMAGE     = 'us-docker.pkg.dev/ml-oss-artifacts-published/ml-public-container/ml-build:latest'
// Broad arch list (Volta -> Blackwell SASS + PTX fallback).
CUDA12_ARCHS = 'sm_70,sm_80,sm_90,sm_120,compute_90'
CUSOLVERMP12 = 'nvidia-cusolvermp-cu12==0.8.0.3126'

// NOTE: CUDA 13 is intentionally not built here. There is no
// nvidia-cusolvermp-cu13 wheel for header/lib discovery, so the cu13 native
// backend cannot be compiled yet. Re-add a cu13 branch once a cu13 cuSOLVERMp
// source is available.

// Compile the native backend for one CUDA major version. This runs inside a pod
// whose image is the JAX CI container (ML_BUILD_IMAGE), so bazel + hermetic CUDA
// are already present and we invoke the JAX CI scripts and build script
// directly (no run_docker_container.sh / docker exec).
def compileNativeBackend(cudaMajor, archs, cusolvermpPkg) {
  withEnv([
    "CUDA_MAJOR=${cudaMajor}",
    "ARCHS=${archs}",
    "CUSOLVERMP_PKG=${cusolvermpPkg}",
    "JAX_GIT_REPOSITORY=${JAX_GIT_REPOSITORY}",
    "JAX_GIT_TAG=${JAX_GIT_TAG}"
  ]) {
    sh '''#!/bin/bash -ex
      WS="$(pwd)"

      # The pod runs as uid 1000 with no $HOME set, so `git config --global`
      # (in JAX's setup_build_environment.sh) and Bazel's output base would try
      # to write to `/`. Point HOME at the writable workspace.
      export HOME="$WS"

      # 1. Clone the JAX repo (provides the `@xla` Bazel external repo).
      rm -rf jax-src
      git clone --depth 1 --branch "$JAX_GIT_TAG" "$JAX_GIT_REPOSITORY" jax-src

      # 2. Stage this jaxmg checkout inside the jax tree so the build sources are
      #    visible alongside the jax checkout (JAX_SRC).
      mkdir -p jax-src/jaxmg
      cp -r src bazel build_native_backend.sh pyproject.toml setup.py jax-src/jaxmg/

      # 3. Generate .jax_configure.bazelrc (CUDA/cuDNN/Bazel config). We are
      #    already inside the ml-build container, so run the CI script directly.
      cd jax-src
      ./ci/build_artifacts.sh jax-cuda-plugin

      # 4. Build the backend against @xla. The ml-build container has no system
      #    nvcc (CUDA is hermetic), so CUDA_MAJOR is passed explicitly.
      if [ -n "$CUSOLVERMP_PKG" ]; then
        python -m pip install "$CUSOLVERMP_PKG"
      fi
      JAX_SRC="$PWD" JAXMG_ROOT="$PWD/jaxmg" CUDA_MAJOR="$CUDA_MAJOR" \
        JAXMG_XLA_CUDA_COMPUTE_CAPABILITIES="$ARCHS" \
        JAXMG_XLA_BAZEL_JOBS="${PARALLEL:-$(nproc)}" \
        ./jaxmg/build_native_backend.sh

      # 5. Copy the built library back into the workspace for stashing.
      cd "$WS"
      mkdir -p "src/jaxmg/cu${CUDA_MAJOR}"
      cp "jax-src/jaxmg/src/jaxmg/cu${CUDA_MAJOR}/libjaxmg_xla_comm_backend.so" \
        "src/jaxmg/cu${CUDA_MAJOR}/"
      echo "Built libs at $WS/src/jaxmg/cu${CUDA_MAJOR}:"
      ls -la "src/jaxmg/cu${CUDA_MAJOR}"
    '''
  }
}

// x86_64 (build + test) and aarch64 (emulated, build-only) run concurrently.
// Each branch keeps its own timeout: emulation is far slower, so aarch64 gets a
// longer budget without holding the native x86 build to it.
parallel(
  'x86_64': {
timeout(time: 2, unit: 'HOURS') {
  // Compile the native backend directly inside the JAX CI container image.
  // Bazel building XLA is CPU/memory heavy and needs no GPU.
  runPod(image: ML_BUILD_IMAGE, cpus: 32, memory: '64Gi') {
    stage('Compile CUDA 12') {
      // Isolate the build (jax-src/ clone, Bazel output base under HOME=$PWD, and
      // src/jaxmg/cu12/ output) so it never shares state with the concurrent
      // aarch64 compile running in this shared job workspace.
      dir('build-x86') {
        compileNativeBackend('12', CUDA12_ARCHS, CUSOLVERMP12)
        // Sanity check: the native lib we are about to stash must be x86_64.
        sh '''#!/bin/bash -ex
          so=src/jaxmg/cu12/libjaxmg_xla_comm_backend.so
          file "$so"
          file "$so" | grep -qi x86-64 \
            || { echo "ERROR: $so is not x86_64" >&2; exit 1; }
        '''
        stash name: 'bin12_x86', includes: 'src/jaxmg/cu12/**', useDefaultExcludes: false
      }
    }
  }

  // Test in a manylinux + local CUDA toolkit image (multiple Python versions),
  // built from .jenkins/Dockerfile12. buildPod builds that image and runs this
  // body in a GPU pod using it (buildPod == buildImage + runPod, args pass
  // through), so there is no separate runPod here.
  buildPod(tag: '12', context: '.jenkins', dockerfile: 'Dockerfile12', devShm: true, gpus: 2, gpuType: 'a100') {
    stage('Test CUDA 12') {
      // Isolate the wheel build + test in its own directory with a private source
      // checkout, so its src/jaxmg/cu12/ (unstashed .so) and src/jaxmg.egg-info/
      // never collide with the concurrent aarch64 build in this shared workspace.
      dir('build-x86') {
      checkout scm
      withEnv([
        "CUDA_ROOT=/usr/local/cuda",
        "CUDNN_ROOT=/usr",
        "CUDA_VISIBLE_DEVICES=0,1",
        "JAXMG_MPMD_LAUNCHER=subprocess",
        // Disable NCCL's cuMem allocator (fails at ncclGroupEnd in the pod) and
        // keep JAX on the conservative platform allocator. The Jenkins GPU pod
        // reports CUDA VMM support, but repeated distributed smoke tests can
        // leave too little contiguous memory for NCCL communicator creation.
        "NCCL_CUMEM_ENABLE=0",
        "XLA_PYTHON_CLIENT_ALLOCATOR=platform",
      ]) {
        sh '''#!/bin/bash -ex
          export PATH="/usr/local/cuda/bin:$PATH"
          export LD_LIBRARY_PATH="/usr/local/cuda/lib64:$LD_LIBRARY_PATH"
        '''

        def cudaVersions = ['cuda12-local']
        def pyVersions = ['3.11', '3.12', '3.13', '3.14']
        def jaxVersions = ['0.10.1']
        for (c in cudaVersions) {
          for (p in pyVersions) {
            for (j in jaxVersions) {
              // Keep the complete CPU/interface suite, then execute the
              // one-rank MPMD smoke cases against the packaged native backend.
              // Restricting visibility to GPU 0 makes cases requesting more
              // ranks skip before launch; broader distributed coverage remains
              // the responsibility of the scheduler-based HPC test suite.
              def pytest_cmd = '''
                python -m pytest -svv -m 'not mpmd' tests
                JAXMG_MPMD_LAUNCHER=subprocess \
                  python -m pytest -svv -m 'mpmd and not slow' tests/mpmd
              '''
              stage("Build ${c}-${p}-${j}") {
                unstash 'bin12_x86'
                withEnv(["WORKDIR=${c}/${p}/${j}", "CUV=${c}", "PYV=${p}", "JAXV=${j}", "CUSOLVERMP_PKG=${CUSOLVERMP12}"]) {
                  sh '''#!/bin/bash -ex
                    mkdir -p "$WORKDIR"

                    python"$PYV" -m venv "$WORKDIR/venv"
                    source "$WORKDIR/venv/bin/activate"

                    python -m pip install --upgrade pip build auditwheel
                    python -m pip install "jax[$CUV]==$JAXV"

                    python -m build --wheel --outdir "$WORKDIR/dist"
                    auditwheel repair \
                      --plat manylinux_2_26_x86_64 \
                      --exclude 'libcuda.so*' \
                      --exclude 'libcusolver.so*' \
                      --exclude 'libcusolverMg.so*' \
                      --exclude 'libcusolverMp.so*' \
                      --exclude 'libcupti.so*' \
                      --exclude 'libcusparse.so*' \
                      --exclude 'libcublasLt.so*' \
                      --exclude 'libcublas.so*' \
                      --exclude 'libnvJitLink.so*' \
                      "$WORKDIR"/dist/jaxmg-*.whl -w "$WORKDIR/dist_repaired"

                    python -m pip install --no-deps "$WORKDIR"/dist_repaired/jaxmg-*.whl
                    # jaxmg links libcusolverMp.so.0, which is excluded from the
                    # wheel and ships in nvidia-cusolvermp-cu12. --no-deps skips
                    # it, so install it explicitly into the test venv.
                    python -m pip install "$CUSOLVERMP_PKG"
                    python -c "import sys, jax; print(f'Python {sys.version_info[:2]}, JAX {jax.__version__}'); print(jax.devices()); import jaxmg"
                  '''
                  archiveArtifacts artifacts: "${WORKDIR}/dist_repaired/*.whl", onlyIfSuccessful: true
                }
              }
              stage("Test ${c}-${p}-${j}") {
                withEnv(["WORKDIR=${c}/${p}/${j}"]) {
                  sh """#!/bin/bash -ex
                    source "$WORKDIR/venv/bin/activate"
                    python -m pip install pytest matplotlib
                    ${pytest_cmd}
                  """
                }
              }
            }
          }
        }
      }
      }
    }
  }
}
  },
  // -------------------------------------------------------------------------
  // aarch64 (arm64) build — emulated, BUILD ONLY. There is no test stage: GPUs
  // are unavailable under QEMU emulation, so we only compile the native backend
  // and package the wheel. Per SCC: build the image FROM a multi-arch base with
  // `buildArgs: '--platform=linux/arm64'` and run it with `emulation: true`, and
  // it is handled transparently. Emulation is slow (especially the Bazel/XLA
  // compile), hence the longer timeout.
  // -------------------------------------------------------------------------
  'aarch64': {
timeout(time: 8, unit: 'HOURS') {
  // 1. Compile the native backend for arm64 inside an emulated JAX CI container.
  //    Dockerfile.mlbuild is a thin FROM-wrapper of ML_BUILD_IMAGE so that
  //    `--platform=linux/arm64` can pull its arm64 layers (the x86 compile uses
  //    runPod(image: ...) directly, which has no buildImage to attach it to).
  buildPod(tag: 'mlbuild-arm64', context: '.jenkins', dockerfile: 'Dockerfile.mlbuild',
           buildArgs: '--platform=linux/arm64', emulation: true,
           cpus: 32, memory: '64Gi') {
    stage('Compile CUDA 12 (arm64)') {
      // Isolate the whole build in a branch-specific directory. compileNativeBackend
      // sets HOME="$(pwd)" (so Bazel's output base is $PWD/.cache/bazel) and clones
      // jax-src/ + writes src/jaxmg/cu12/ under $PWD. Running concurrently with the
      // x86_64 compile in this shared job workspace, both would otherwise share the
      // Bazel cache and jax-src: the fast native build populates the cache first and
      // the emulated arm64 build links those x86_64 objects, yielding an x86_64 .so.
      dir('build-arm64') {
        compileNativeBackend('12', CUDA12_ARCHS, CUSOLVERMP12)
        // Fail fast (with a clear message) if we did not actually produce an
        // aarch64 binary, rather than failing cryptically later in auditwheel.
        sh '''#!/bin/bash -ex
          so=src/jaxmg/cu12/libjaxmg_xla_comm_backend.so
          file "$so"
          file "$so" | grep -qi aarch64 \
            || { echo "ERROR: $so is not aarch64 -- the emulated build produced the wrong arch" >&2; exit 1; }
        '''
        stash name: 'bin12_arm64', includes: 'src/jaxmg/cu12/**', useDefaultExcludes: false
      }
    }
  }

  // 2. Package the wheel for arm64 in an emulated manylinux aarch64 + CUDA image.
  buildPod(tag: '12-arm64', context: '.jenkins', dockerfile: 'Dockerfile12_aarch64',
           buildArgs: '--platform=linux/arm64', emulation: true) {
    stage('Build CUDA 12 (arm64)') {
      // Fully isolate the arm64 wheel build in its own directory with a private
      // source checkout. buildPod checks the repo out at the shared job
      // workspace root; running there, this build's src/jaxmg/cu12/ (the
      // unstashed .so) and src/jaxmg.egg-info/ would collide with the concurrent
      // x86_64 wheel build. Inside dir('build-arm64'), unstash/build/archive all
      // resolve under build-arm64/, so the two branches never share a path.
      dir('build-arm64') {
      checkout scm
      def cudaVersions = ['cuda12-local']
      def pyVersions = ['3.11', '3.12', '3.13', '3.14']
      def jaxVersions = ['0.10.1']
      for (c in cudaVersions) {
        for (p in pyVersions) {
          for (j in jaxVersions) {
            stage("Build ${c}-${p}-${j} (arm64)") {
              unstash 'bin12_arm64'
              withEnv(["WORKDIR=arm64/${c}/${p}/${j}", "CUV=${c}", "PYV=${p}", "JAXV=${j}", "CUSOLVERMP_PKG=${CUSOLVERMP12}"]) {
                sh '''#!/bin/bash -ex
                  mkdir -p "$WORKDIR"

                  # Sanity check: the unstashed native lib we are about to
                  # package must be aarch64.
                  so=src/jaxmg/cu12/libjaxmg_xla_comm_backend.so
                  file "$so"
                  file "$so" | grep -qi aarch64 \
                    || { echo "ERROR: $so is not aarch64 before packaging" >&2; exit 1; }

                  python"$PYV" -m venv "$WORKDIR/venv"
                  source "$WORKDIR/venv/bin/activate"

                  python -m pip install --upgrade pip build auditwheel
                  python -m pip install "jax[$CUV]==$JAXV"

                  python -m build --wheel --outdir "$WORKDIR/dist"
                  auditwheel repair \
                    --plat manylinux_2_28_aarch64 \
                    --exclude 'libcuda.so*' \
                    --exclude 'libcusolver.so*' \
                    --exclude 'libcusolverMg.so*' \
                    --exclude 'libcusolverMp.so*' \
                    --exclude 'libcupti.so*' \
                    --exclude 'libcusparse.so*' \
                    --exclude 'libcublasLt.so*' \
                    --exclude 'libcublas.so*' \
                    --exclude 'libnvJitLink.so*' \
                    "$WORKDIR"/dist/jaxmg-*.whl -w "$WORKDIR/dist_repaired"

                  python -m pip install --no-deps "$WORKDIR"/dist_repaired/jaxmg-*.whl
                  # jaxmg links libcusolverMp.so.0, which is excluded from the
                  # wheel and ships in nvidia-cusolvermp-cu12. --no-deps skips
                  # it, so install it explicitly into the build venv.
                  python -m pip install "$CUSOLVERMP_PKG"
                  # Build-only: confirm the wheel installs and imports, but do
                  # NOT `import jaxmg` — that triggers native-backend/GPU init,
                  # which cannot run under emulation without a GPU.
                  python -c "import sys, jax, importlib.util; print(f'Python {sys.version_info[:2]}, JAX {jax.__version__}'); assert importlib.util.find_spec('jaxmg'), 'jaxmg not installed'"
                '''
                archiveArtifacts artifacts: "${WORKDIR}/dist_repaired/*.whl", onlyIfSuccessful: true
              }
            }
          }
        }
      }
      }
    }
  }
}
  }
)
