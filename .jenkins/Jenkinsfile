pipeline {
    agent {
        dockerfile {
            filename '.jenkins/Dockerfile'
            args '--gpus=2 --shm-size=4gb'
            label 'docker && v100'
        }
    }
    options {
        timeout(time: 30, unit: 'MINUTES')
    }
    environment {
        HOME = "$WORKSPACE"
    }
    stages {
        stage('Compile') {
            environment {
                PARALLEL = "${env.PARALLEL}"
            }
            // matrix {
            //     axes {
            //         axis {
            //             name 'PYTHON_VERSION'
            //             values '3.11'
            //         }
            //     }}
            steps {
                sh '''#!/bin/bash -ex
                    export CUDA_ROOT=/usr/local/cuda
                    export CUDNN_ROOT=/usr
                    export PATH=/usr/local/cuda/bin:$PATH
                    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
                    mkdir -p third_party/gpus
                    ln -sfn third_party/gpus/cuda
                    mkdir -p build && cd build
                    cmake -DCMAKE_BUILD_TYPE=Release ..
                    cmake --build . --target install -- -j$PARALLEL
                '''
                sh '''#!/bin/bash -ex
                    python3.11 -m pip install --upgrade pip build
                    python3.11 -m build --wheel --outdir dist
                    ls -lh dist/
                '''
            }
        }
        stage('Build and Test')
        {
            matrix {
                axes {
                    axis {
                        name 'JAX_VERSION'
                        values '0.6.2', '0.7.2', '0.8.1'
                    }
                }
                environment {
                    CUDA_VISIBLE_DEVICES = '0,1'
                }
                stages {
                    stage('Install') {
                        steps {
                            sh '''#!/bin/bash -ex
                                python3.11 -m venv $HOME/$JAX_VERSION/.venv
                                source $HOME/$JAX_VERSION/.venv/bin/activate
                                python3.11 -m pip install --upgrade pip
                                python3.11 -m pip install "jax[cuda12]==$JAX_VERSION"
                                python3.11 -m pip install --no-deps dist/jaxmg-*.whl
                                python3.11 -c "import sys, jax, jaxmg; print(f'Python {sys.version_info[:2]}, JAX {jax.__version__}')"
                            '''
                        }
                    }
                    stage('Test') {
                        steps {
                            sh '''#!/bin/bash -ex
                                source $HOME/$JAX_VERSION/.venv/bin/activate
                                python3.11 -m pip install pytest matplotlib
                                python3.11 -m pytest -svv
                            '''
                        }
                    }
                }
            }
        }
    }
}
