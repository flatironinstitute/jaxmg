pipeline {
    agent {
        dockerfile {
            filename '.jenkins/Dockerfile'
            args '--gpus=2 --shm-size=4gb'
            label 'docker && v100'
        }
    }
    options {
        timeout(time: 30, unit: 'MINUTES')
    }
    environment {
        HOME = "$WORKSPACE"
    }
    stages {
        stage('Build') {
            environment {
                PARALLEL = "${env.PARALLEL}"
            }
            steps {
                sh '''#!/bin/bash -ex
                    export CUDA_ROOT=/usr/local/cuda
                    export CUDNN_ROOT=/usr
                    export PATH=/usr/local/cuda/bin:$PATH
                    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH
                    mkdir -p third_party/gpus
                    ln -sfn third_party/gpus/cuda
                    mkdir -p build && cd build
                    cmake -DCMAKE_BUILD_TYPE=Release ..
                    cmake --build . --target install -- -j$PARALLEL
                '''
                sh '''#!/bin/bash -ex
                    python3 -m venv $HOME/.venv
                    source $HOME/.venv/bin/activate
                    python3 -m pip install --upgrade pip build
                    python3 -m build --wheel
                '''
            }
        }
        stage('Test') {
            environment {
                CUDA_VISIBLE_DEVICES = '0,1'
            }
            matrix {
                axes {
                    axis {
                        name 'JAX_VERSION'
                        values '0.6.1', '0.7.1', '0.8.1'
                    }
                }
                stages {
                    stage('TestJaxVersion') {
                        steps {
                            sh '''#!/bin/bash -ex
                        source $HOME/.venv/bin/activate
                        python3 -m pip install dist/jaxmg-*.whl "jax[cuda12]==$JAX_VERSION"
                        python3 -m pip install pytest matplotlib
                        python3 -m pytest -svv
                        '''
                        }
                    }
                }
            }
        }
    }
}
