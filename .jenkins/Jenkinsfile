pipeline {
    agent none
    stages {
        stage('CUDA 12 (local)') {
            agent {
                dockerfile {
                    filename '.jenkins/Dockerfile12'
                    args '--gpus=2 --shm-size=4gb'
                    label 'docker && v100'
                }
            }

            options {
                timeout(time: 60, unit: 'MINUTES')
            }
            steps {
                sh '''#!/bin/bash -ex
                    echo "CUDA12 (local)"
                '''
            }
        }
        stage('CUDA 13 (local)') {
            agent {
                dockerfile {
                    filename '.jenkins/Dockerfile13'
                    args '--gpus=2 --shm-size=4gb'
                    label 'docker && v100'
                }
            }

            options {
                timeout(time: 60, unit: 'MINUTES')
            }
            steps {
                sh '''#!/bin/bash -ex
                    echo "CUDA13 (local)"
                '''
            }
        }
    }
}
