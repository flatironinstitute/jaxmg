pipeline {
    agent none

    options {
        timeout(time: 60, unit: 'MINUTES')
    }

    stages {
        stage('Checkout + Compile') {
            agent {
                dockerfile {
                    filename '.jenkins/Dockerfile'
                    args '--shm-size=4gb'
                    label 'docker'
                    reuseNode false
                }
            }
            environment {
                PARALLEL = "${env.PARALLEL}"
            }
            steps {
                checkout scm
                sh '''#!/bin/bash -ex
                    export CUDA_ROOT=/usr/local/cuda
                    export CUDNN_ROOT=/usr
                    export PATH=/usr/local/cuda/bin:$PATH
                    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH

                    mkdir -p build && cd build
                    cmake -DCMAKE_BUILD_TYPE=Release ..
                    cmake --build . --target install -- -j${PARALLEL:-$(nproc)}
                '''
                stash name: 'compiled-bin', includes: 'src/jaxmg/bin/**', useDefaultExcludes: false
            }
        }

        stage('Build and Test Matrix') {
            matrix {
                agent {
                    dockerfile {
                        filename '.jenkins/Dockerfile'
                        args '--gpus=2 --shm-size=4gb'
                        label 'docker && v100'
                        reuseNode false
                    }
                }
                axes {
                    axis {
                        name 'PYTHON_VERSION'
                        values '3.11'//, '3.12', '3.13'
                    }
                    axis {
                        name 'JAX_VERSION'
                        values '0.6.2'//, '0.7.2', '0.8.1'
                    }
                }
                environment {
                    CUDA_VISIBLE_DEVICES = '0,1'
                    PARALLEL = "${env.PARALLEL}"
                }
                stages {
                    stage('Build') {
                        steps {
                            checkout scm
                            unstash 'compiled-bin'
                            sh '''#!/bin/bash -ex
                                python${PYTHON_VERSION} -m venv venv
                                source venv/bin/activate

                                python -m pip install --upgrade pip build
                                python -m pip install "jax[cuda12-local]==$JAX_VERSION"

                                python -m build --wheel

                                python -m pip install --no-deps dist/jaxmg-*.whl
                                python -c "import sys, jax, jaxmg; print(f'Python {sys.version_info[:2]}, JAX {jax.__version__}')"
                            '''
                        }
                    }
                    stage('Test') {
                        steps {
                            sh '''#!/bin/bash -ex
                                source venv/bin/activate
                                python -m pip install pytest matplotlib
                                python -m pytest -svv
                            '''
                        }
                    }
                }
            }
        }
    }
}
