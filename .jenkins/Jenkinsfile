// GPU test job. Jenkins no longer builds anything: the x86_64 wheels are built
// on GitHub Actions and this job downloads them (by GHA run id) and runs the
// A100 test suite. It is triggered by the GHA `jenkins-test` reusable workflow
// via buildWithParameters. See .github/workflows/{ci,release,jenkins-test}.yml.
properties([
  parameters([
    string(name: 'GHA_RUN_ID', defaultValue: '',
           description: 'GitHub Actions run id whose wheel artifacts to test'),
    string(name: 'GIT_SHA', defaultValue: '',
           description: 'Commit SHA under test (matches the built wheels)'),
    password(name: 'GH_TOKEN', defaultValue: '',
             description: 'Short-lived GitHub token (actions:read) to download the wheel artifacts'),
  ]),
  disableConcurrentBuilds(),
  buildDiscarder(logRotator(numToKeepStr: '8', daysToKeepStr: '30')),
])

GITHUB_REPO  = 'flatironinstitute/jaxmg'
CUSOLVERMP12 = 'nvidia-cusolvermp-cu12==0.8.0.3126'

// Test in a manylinux + local CUDA toolkit image, across Python versions, on 2 A100s.
buildPod(tag: '12', context: '.jenkins', dockerfile: 'Dockerfile12', devShm: true, gpus: 2, gpuType: 'a100') {
  stage('Test CUDA 12') {
    checkout scm
    // Test the exact commit that produced the wheels.
    if (params.GIT_SHA?.trim()) {
      sh "git fetch --all --quiet && git checkout --quiet ${params.GIT_SHA}"
    }

    withEnv([
      "CUDA_ROOT=/usr/local/cuda",
      "CUDNN_ROOT=/usr",
      "CUDA_VISIBLE_DEVICES=0,1",
      "JAXMG_MPMD_LAUNCHER=subprocess",
      // Disable NCCL's cuMem allocator (fails at ncclGroupEnd in the pod) and
      // keep JAX on the conservative platform allocator.
      "NCCL_CUMEM_ENABLE=0",
      "XLA_PYTHON_CLIENT_ALLOCATOR=platform",
      "GHA_RUN_ID=${params.GHA_RUN_ID}",
      "GITHUB_REPO=${GITHUB_REPO}",
    ]) {
      // Download the x86_64 wheels produced by the triggering GHA run, using the
      // short-lived GH_TOKEN passed by GitHub Actions (no stored credential).
      stage('Fetch GHA wheels') {
        // Pass the token via env; do NOT interpolate it into the shell in a way
        // that could be traced. The script runs without `set -x` for that reason.
        withEnv(["GH_TOKEN=${params.GH_TOKEN}"]) {
          sh '''#!/bin/bash
            set -eo pipefail
            set +x   # never trace: GH_TOKEN must not reach the log
            if [ -z "$GHA_RUN_ID" ]; then
              echo "GHA_RUN_ID parameter is required" >&2; exit 1
            fi
            if [ -z "$GH_TOKEN" ]; then
              echo "GH_TOKEN parameter is required" >&2; exit 1
            fi
            rm -rf dist && mkdir -p dist
            api="https://api.github.com/repos/${GITHUB_REPO}/actions/runs/${GHA_RUN_ID}/artifacts?per_page=100"
            curl -fsS -H "Authorization: Bearer ${GH_TOKEN}" \
                 -H "Accept: application/vnd.github+json" "$api" -o artifacts.json

            # Download + unzip every wheels-x86_64-* artifact into dist/.
            python3 - <<'PY' > urls.txt
import json
d = json.load(open("artifacts.json"))
for a in d["artifacts"]:
    if a["name"].startswith("wheels-x86_64-"):
        print(a["id"], a["name"])
PY
            [ -s urls.txt ] || { echo "no wheels-x86_64-* artifacts in run $GHA_RUN_ID" >&2; exit 1; }
            while read -r id name; do
              curl -fsSL -H "Authorization: Bearer ${GH_TOKEN}" \
                   "https://api.github.com/repos/${GITHUB_REPO}/actions/artifacts/${id}/zip" \
                   -o "dist/${name}.zip"
              (cd dist && unzip -o "${name}.zip" && rm -f "${name}.zip")
            done < urls.txt
            echo "Fetched wheels:"; ls -la dist/*.whl
          '''
        }
      }

      def pyVersions = ['3.11', '3.12', '3.13', '3.14']
      for (p in pyVersions) {
        stage("Test py${p}") {
          withEnv(["PYV=${p}", "CUSOLVERMP_PKG=${CUSOLVERMP12}"]) {
            sh '''#!/bin/bash -ex
              export PATH="/usr/local/cuda/bin:$PATH"
              export LD_LIBRARY_PATH="/usr/local/cuda/lib64:$LD_LIBRARY_PATH"
              PYTAG="cp${PYV/./}"

              whl=$(ls dist/jaxmg-*-${PYTAG}-${PYTAG}-*.whl | head -1)
              [ -n "$whl" ] || { echo "no x86_64 wheel for ${PYTAG}" >&2; exit 1; }

              python"$PYV" -m venv "venv/$PYV"
              source "venv/$PYV/bin/activate"
              python -m pip install --upgrade pip

              # Install jax (CUDA plugins) first, then the jaxmg wheel with
              # --no-deps, then the cuSOLVERMp runtime it links, then test deps.
              python -m pip install "jax[cuda12-local]==0.10.1"
              python -m pip install --no-deps "$whl"
              python -m pip install "$CUSOLVERMP_PKG"
              python -m pip install pytest matplotlib

              python -c "import sys, jax, jaxmg; print(f'Python {sys.version_info[:2]}, JAX {jax.__version__}'); print(jax.devices())"

              python -m pytest -svv -m 'not mpmd' tests
              JAXMG_MPMD_LAUNCHER=subprocess \
                python -m pytest -svv -m 'mpmd and not slow' tests/mpmd
            '''
          }
        }
      }
    }
  }
}
