pipeline {
    agent none
    stages {
        stage('CUDA 12') {
            agent {
                dockerfile {
                    filename '.jenkins/Dockerfile12'
                    args '--gpus=2 --shm-size=4gb'
                    label 'docker && v100'
                }
            }

            options {
                timeout(time: 60, unit: 'MINUTES')
            }
            stages {
                stage('Compile') {
                    environment {
                        PARALLEL = "${env.PARALLEL}"
                    }
                    steps {
                        withEnv([
                            'CUDA_ROOT=/usr/local/cuda',
                            'CUDNN_ROOT=/usr',
                        ]) {
                            sh '''#!/bin/bash -ex
                            # Save original env, then set CUDA paths only for compilation
                            ORIG_PATH="$PATH"
                            ORIG_LD_LIBRARY_PATH="$LD_LIBRARY_PATH"
                            export PATH="/usr/local/cuda/bin:$PATH"
                            export LD_LIBRARY_PATH="/usr/local/cuda/lib64:$LD_LIBRARY_PATH"

                            mkdir -p build && cd build
                            cmake -DCMAKE_BUILD_TYPE=Release ..
                            cmake --build . --target install -- -j${PARALLEL:-$(nproc)}
                            echo "Built libs at $WORKSPACE/src/jaxmg/bin:"
                            ls -la "$WORKSPACE/src/jaxmg/bin"
                            '''
                        }
                        stash name: 'bin12', includes: 'src/jaxmg/bin/**', useDefaultExcludes: false
                    }
                }
                stage('Build+Test') {
                    environment {
                        CUDA_VISIBLE_DEVICES = '0,1'
                        PARALLEL = "${env.PARALLEL}"
                    }
                    steps {
                        script {
                            def cudaVersions = ['cuda12-local', ]
                            def pyVersions = ['3.11',]
                            def jaxVersions = ['0.6.2', '0.7.1', '0.8.1']
                            for (c in cudaVersions) {
                                for (p in pyVersions) {
                                    for (j in jaxVersions) {
                                        stage("Build ${c}-${p}-${j}") {
                                            unstash 'bin12'
                                            withEnv(["WORKDIR=${c}/${p}/${j}", "CUV=${c}", "PYV=${p}", "JAXV=${j}"]) {
                                                sh '''#!/bin/bash -ex
                                                    mkdir -p "$WORKDIR"

                                                    python"$PYV" -m venv "$WORKDIR/venv"
                                                    source "$WORKDIR/venv/bin/activate"

                                                    # Restore original env; set CUDA paths only for *-local variants
                                                    ORIG_PATH="$PATH"
                                                    ORIG_LD_LIBRARY_PATH="$LD_LIBRARY_PATH"
                                                    if [ "$CUV" = "cuda12-local" ]; then
                                                        export PATH="/usr/local/cuda/bin:$ORIG_PATH"
                                                        export LD_LIBRARY_PATH="/usr/local/cuda/lib64:$ORIG_LD_LIBRARY_PATH"
                                                    else
                                                        export PATH="$ORIG_PATH"
                                                        export LD_LIBRARY_PATH="$ORIG_LD_LIBRARY_PATH"
                                                    fi

                                                    python -m pip install --upgrade pip build
                                                    python -m pip install "jax[$CUV]==$JAXV"

                                                    # Build wheel from project root, output to the cell-specific dist
                                                    python -m build --wheel --outdir "$WORKDIR/dist"

                                                    # Do not quote the wildcard; allow shell globbing
                                                    python -m pip install --no-deps "$WORKDIR"/dist/jaxmg-*.whl
                                                    python -c "import sys, jax; print(f'Python {sys.version_info[:2]}, JAX {jax.__version__}'); print(jax.devices()); import jaxmg"
                                                '''
                                            }
                                        }
                                        stage("Test ${c}-${p}-${j}") {
                                            withEnv(["WORKDIR=${c}/${p}/${j}"]) {
                                                sh '''#!/bin/bash -ex
                                                    nukegpu() {
                                                        local pids
                                                        pids=$(nvidia-smi --query-compute-apps=pid --format=csv,noheader 2>/dev/null | sed '/^$/d' | sort -u)
                                                        if [ -z "$pids" ]; then
                                                            echo "nukegpu_all: no GPU PIDs."
                                                            return 0
                                                        fi
                                                        echo "nukegpu_all: killing ALL GPU PIDs -> $pids"
                                                        for pid in $pids; do
                                                            kill -9 "$pid" 2>/dev/null || sudo kill -9 "$pid" 2>/dev/null || echo "could not kill $pid"
                                                        done
                                                    }

                                                    # Ensure GPUs are free before running tests
                                                    nukegpu || true
                                                    source "$WORKDIR/venv/bin/activate"
                                                    python -m pip install pytest matplotlib
                                                    python -m pytest -svv tests
                                                '''
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        stage('CUDA 13') {
            agent {
                dockerfile {
                    filename '.jenkins/Dockerfile13'
                    args '--gpus=2 --shm-size=4gb'
                    label 'docker && v100'
                }
            }

            options {
                timeout(time: 60, unit: 'MINUTES')
            }
            stages {
                stage('Compile') {
                    environment {
                        PARALLEL = "${env.PARALLEL}"
                    }
                    steps {
                        withEnv([
                            'CUDA_ROOT=/usr/local/cuda',
                            'CUDNN_ROOT=/usr',
                        ]) {
                            sh '''#!/bin/bash -ex
                            # Save original env, then set CUDA paths only for compilation
                            ORIG_PATH="$PATH"
                            ORIG_LD_LIBRARY_PATH="$LD_LIBRARY_PATH"
                            export PATH="/usr/local/cuda/bin:$PATH"
                            export LD_LIBRARY_PATH="/usr/local/cuda/lib64:$LD_LIBRARY_PATH"

                            mkdir -p build && cd build
                            cmake -DCMAKE_BUILD_TYPE=Release ..
                            cmake --build . --target install -- -j${PARALLEL:-$(nproc)}
                            echo "Built libs at $WORKSPACE/src/jaxmg/bin:"
                            ls -la "$WORKSPACE/src/jaxmg/bin"
                            '''
                        }
                        stash name: 'bin13', includes: 'src/jaxmg/bin/**', useDefaultExcludes: false
                    }
                }
                stage('Build+Test') {
                    environment {
                        CUDA_VISIBLE_DEVICES = '0,1'
                        PARALLEL = "${env.PARALLEL}"
                    }
                    steps {
                        script {
                            def cudaVersions = ['cuda13-local', ]
                            def pyVersions = ['3.11', ]
                            def jaxVersions = ['0.7.2', '0.8.1']
                            for (c in cudaVersions) {
                                for (p in pyVersions) {
                                    for (j in jaxVersions) {
                                        stage("Build ${c}-${p}-${j}") {
                                            unstash 'bin13'
                                            withEnv(["WORKDIR=${c}/${p}/${j}", "CUV=${c}", "PYV=${p}", "JAXV=${j}"]) {
                                                sh '''#!/bin/bash -ex
                                                    mkdir -p "$WORKDIR"

                                                    python"$PYV" -m venv "$WORKDIR/venv"
                                                    source "$WORKDIR/venv/bin/activate"

                                                    # Restore original env; set CUDA paths only for *-local variants
                                                    ORIG_PATH="$PATH"
                                                    ORIG_LD_LIBRARY_PATH="$LD_LIBRARY_PATH"
                                                    if [ "$CUV" = "cuda13-local" ]; then
                                                        export PATH="/usr/local/cuda/bin:$ORIG_PATH"
                                                        export LD_LIBRARY_PATH="/usr/local/cuda/lib64:$ORIG_LD_LIBRARY_PATH"
                                                    else
                                                        export PATH="$ORIG_PATH"
                                                        export LD_LIBRARY_PATH="$ORIG_LD_LIBRARY_PATH"
                                                    fi

                                                    python -m pip install --upgrade pip build
                                                    python -m pip install "jax[$CUV]==$JAXV"

                                                    # Build wheel from project root, output to the cell-specific dist
                                                    python -m build --wheel --outdir "$WORKDIR/dist"

                                                    # Do not quote the wildcard; allow shell globbing
                                                    python -m pip install --no-deps "$WORKDIR"/dist/jaxmg-*.whl
                                                    python -c "import sys, jax, jaxmg; print(f'Python {sys.version_info[:2]}, JAX {jax.__version__}'); print(jax.devices())"
                                                '''
                                            }
                                        }
                                        stage("Test ${c}-${p}-${j}") {
                                            withEnv(["WORKDIR=${c}/${p}/${j}"]) {
                                                sh '''#!/bin/bash -ex
                                                    nukegpu() {
                                                        local pids
                                                        pids=$(nvidia-smi --query-compute-apps=pid --format=csv,noheader 2>/dev/null | sed '/^$/d' | sort -u)
                                                        if [ -z "$pids" ]; then
                                                            echo "nukegpu_all: no GPU PIDs."
                                                            return 0
                                                        fi
                                                        echo "nukegpu_all: killing ALL GPU PIDs -> $pids"
                                                        for pid in $pids; do
                                                            kill -9 "$pid" 2>/dev/null || sudo kill -9 "$pid" 2>/dev/null || echo "could not kill $pid"
                                                        done
                                                    }
                                                    # Ensure GPUs are free before running tests
                                                    nukegpu || true
                                                    source "$WORKDIR/venv/bin/activate"
                                                    python -m pip install pytest matplotlib
                                                    python -m pytest -svv tests
                                                '''
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
