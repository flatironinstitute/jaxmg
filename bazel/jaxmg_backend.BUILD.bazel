# Copied by build_native_backend.sh into the pinned OpenXLA checkout.
# Keep these internal XLA dependencies in sync with XLA_GIT_TAG.

load("@local_config_cuda//cuda:build_defs.bzl", "cuda_library")

package(default_visibility = ["//visibility:public"])

cuda_library(
    name = "layout_convert_cuda",
    srcs = ["memory_redist/layout_convert.cu.cc"],
    hdrs = ["memory_redist/layout_convert.h"],
    alwayslink = True,
    tags = ["cuda-only"],
    deps = [
        "@local_config_cuda//cuda:cuda_headers",
    ],
)

cc_binary(
    name = "libjaxmg_xla_comm_backend.so",
    srcs = [
        "cusolvermp_routines/cusolvermp_common.cc",
        "cusolvermp_routines/cusolvermp_common.h",
        "cusolvermp_routines/cusolvermp_potrs.cc",
        "cusolvermp_routines/cusolvermp_routines.h",
        "cusolvermp_routines/cusolvermp_syevd.cc",
        "memory_redist/block_cyclic_2d.cc",
        "memory_redist/edge_padding_2d.cc",
        "memory_redist/rectangle_pack.cc",
        "memory_redist/memory_redist.h",
        "memory_redist/scratch.cc",
        "xla_ffi/handlers.cc",
        "xla_ffi/runtime.cc",
        "xla_ffi/runtime.h",
    ],
    linkshared = True,
    linkstatic = True,
    copts = [
        "-Iexternal/rules_ml_toolchain~~cuda_redist_init_ext~cuda_cudart/include",
        "-Iexternal/rules_ml_toolchain~~cuda_redist_init_ext~cuda_cusolver/include",
        "-Iexternal/rules_ml_toolchain~~cuda_redist_init_ext~cuda_nvcc/include",
        "-Iexternal/rules_ml_toolchain~~cuda_redist_init_ext~cuda_cublas/include",
        "-Iexternal/_main~cccl_extension~cuda_cccl/libcudacxx/include",
        "-Ijaxmg_backend/cusolvermp_include",
    ],
    linkopts = [
        "-Lexternal/rules_ml_toolchain~~cuda_redist_init_ext~cuda_cusolver/lib",
        "-Ljaxmg_backend/cusolvermp_lib",
        "-l:libcusolverMp.so.0",
        "-Wl,-rpath,$ORIGIN/../../nvidia/cu@JAXMG_CUDA_MAJOR@/lib",
    ],
    deps = [
        ":layout_convert_cuda",
        "@local_config_cuda//cuda:cuda_headers",
        "@cuda_cudart//:cudart",
        "@cuda_cusolver//:cusolver",
        "//xla:xla_data_proto_cc",
        "//xla/backends/gpu/collectives:gpu_clique_key",
        "//xla/backends/gpu/collectives:gpu_collectives",
        "//xla/backends/gpu/collectives:gpu_communicator",
        "//xla/backends/gpu:ffi",
        "//xla/backends/gpu/runtime:collective_clique_requests",
        "//xla/backends/gpu/runtime:collective_cliques",
        "//xla/backends/gpu/runtime:collective_execution",
        "//xla/backends/gpu/runtime:collective_params",
        "//xla/core/collectives:communicator",
        "//xla/core/collectives:rank_id",
        "//xla/core/collectives:reduction_kind",
        "//xla/ffi",
        "//xla/ffi:ffi_api",
        "//xla:future",
        "//xla/runtime:device_id",
        "//xla/stream_executor:stream",
        "//xla/tsl/cuda:nccl",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:statusor",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
    ],
)
